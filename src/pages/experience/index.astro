---
import { getCollection, render } from 'astro:content'
import { TypographyH3 } from '@/components/ui/typography'
import { siteConfig } from '@/config/site'
import { NAME, POSITION } from '@/consts'
import PageHeader from '@/features/common/presentation/page-header.astro'
import MainLayout from '@/layouts/main-layout.astro'

const experiences = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order)

const renderedExperiences = await Promise.all(
  experiences.map(async exp => {
    const { Content } = await render(exp)
    return { ...exp, Content }
  })
)

const experienceLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: `Experience - ${NAME}`,
  description: `Professional experience and career journey of ${NAME}, ${POSITION}.`,
  url: `${siteConfig.url}/experience`,
  mainEntity: {
    '@type': 'Person',
    name: NAME,
    url: siteConfig.url,
    hasOccupation: experiences.map(exp => ({
      '@type': 'Occupation',
      name: exp.data.role,
      occupationLocation: {
        '@type': 'Organization',
        name: exp.data.company
      },
      description: `${exp.data.role} at ${exp.data.company} (${exp.data.period})`
    }))
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: siteConfig.url
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Experience',
        item: `${siteConfig.url}/experience`
      }
    ]
  }
}
---

<MainLayout title="Experience" description={`Professional experience and career journey of ${NAME}, ${POSITION}.`}>
  <section class="py-8 sm:py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <PageHeader
        class="lg:mb-24"
        eyebrow="Career"
        title="Professional Experience"
        description="My journey building scalable platforms, AI systems, and full-stack applications."
      />

      <div class="mx-auto max-w-4xl">
        <div class="relative border-l-2 border-border">
          {renderedExperiences.map((exp, index) => (
              <div
                class:list={[
                  "relative pb-12 pl-8 sm:pl-12",
                  { "pb-0": index === renderedExperiences.length - 1 },
                ]}
              >
                {/* Timeline dot */}
                <div class="absolute -left-[calc(0.5rem+1px)] top-[6px] h-4 w-4 rounded-full bg-primary" />

                {/* Header */}
                <div class="mb-4">
                  <TypographyH3 className="tracking-normal sm:text-2xl text-xl">
                    {exp.data.role}
                  </TypographyH3>
                  <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-muted-foreground">
                    <span class="font-medium text-foreground">
                      {exp.data.company}
                    </span>
                    <span class="hidden sm:inline">&middot;</span>
                    <span>{exp.data.period}</span>
                    <span class="hidden sm:inline">&middot;</span>
                    <span class="rounded-full bg-muted px-2.5 py-0.5 text-xs font-medium">
                      {exp.data.duration}
                    </span>
                  </div>
                </div>

                {/* Markdown content */}
                <div class="prose prose-base max-w-none dark:prose-invert prose-headings:text-base prose-headings:font-semibold prose-headings:mt-4 prose-headings:mb-2 prose-ul:my-1 prose-li:my-1 prose-p:my-1">
                  <exp.Content />
                </div>
              </div>
            ))}
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script type="application/ld+json" set:html={JSON.stringify(experienceLd)} />
