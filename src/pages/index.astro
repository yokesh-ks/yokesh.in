---
import { getCollection, render } from 'astro:content'
import { stats } from '@/assets/data/about-us'
import { contactInfo } from '@/assets/data/contact-us'
import { menudata } from '@/assets/data/hero'
import { skillCategories } from '@/assets/data/skills'
import AboutUs from '@/components/blocks/about-us-section/about-us-page'
import ContactUs from '@/components/blocks/contact-us-section/contact-us-page'
import FeaturedProjects from '@/components/blocks/featured-projects/featured-projects'
import HeroSectionPage from '@/components/blocks/hero-section/hero-section'
import SkillsSection from '@/components/blocks/skills-section/skills-section'
import { TypographyH3 } from '@/components/ui/typography'
import { NAME, POSITION } from '@/consts'
import BlogCard from '@/features/blog/presentation/card.astro'
import PageHeader from '@/features/common/presentation/page-header.astro'
import Layout from '@/layouts/Layout.astro'
import { getFeaturedProjects, getPosts } from '@/lib/fetchers'

// Page-specific SEO configuration
const pageTitle = ''
const pageDescription = `${NAME} is a ${POSITION} specializing in React.js, TypeScript, and Node.js — building scalable, production-ready web applications.`
const pageKeywords = `${NAME}, ${POSITION}, GenAI, AI Systems, SaaS, React, TypeScript, Node.js, Portfolio`

const allPosts = await getPosts()
const latestPosts = allPosts.slice(0, 3)

const featuredProjects = await getFeaturedProjects()

const experiences = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order)

const renderedExperiences = await Promise.all(
  experiences.map(async exp => {
    const { Content } = await render(exp)
    return { ...exp, Content }
  })
)

// Structured data for better SEO
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `${NAME} – ${POSITION} | React.js | Node.js | Full-Stack Development`,
  description: pageDescription,
  applicationCategory: 'PortfolioApplication',
  operatingSystem: 'Any',
  author: {
    '@type': 'Person',
    name: NAME
  }
}
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} schema={schema}>
  <link rel="preload" as="image" href="/images/hero-section/04-hackathon-august-ai.webp" fetchpriority="high">
  <HeroSectionPage menudata={menudata} client:load />
  <FeaturedProjects projects={featuredProjects} client:load />
  <AboutUs stats={stats} />
  <section
    id="experience"
    class="relative py-8 before:absolute before:inset-0 before:-z-10 before:-skew-y-3 before:border-primary/20 before:border-b sm:py-16 lg:py-24"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <PageHeader
        class="lg:mb-24"
        eyebrow="Career"
        title="Professional Experience"
        description="My journey building scalable platforms, AI systems, and full-stack applications."
      />

      <div class="mx-auto max-w-4xl">
        <div class="relative border-l-2 border-border">
          {renderedExperiences.map((exp, index) => (
              <div
                class:list={[
                  "relative pb-12 pl-8 sm:pl-12",
                  { "pb-0": index === renderedExperiences.length - 1 },
                ]}
              >
                <div class="absolute -left-[calc(0.5rem+1px)] top-[6px] h-4 w-4 rounded-full bg-primary" />

                <div class="mb-4">
                  <TypographyH3 className="tracking-normal sm:text-2xl text-xl">
                    {exp.data.role}
                  </TypographyH3>
                  <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-muted-foreground">
                    <span class="font-medium text-foreground">
                      {exp.data.company}
                    </span>
                    <span class="hidden sm:inline">&middot;</span>
                    <span>{exp.data.period}</span>
                    <span class="hidden sm:inline">&middot;</span>
                    <span class="rounded-full bg-muted px-2.5 py-0.5 text-xs font-medium">
                      {exp.data.duration}
                    </span>
                  </div>
                </div>

                <div class="prose prose-base max-w-none dark:prose-invert prose-headings:text-base prose-headings:font-semibold prose-headings:mt-4 prose-headings:mb-2 prose-ul:my-1 prose-li:my-1 prose-p:my-1">
                  <exp.Content />
                </div>
              </div>
            ))}
        </div>
      </div>
    </div>
  </section>
  <SkillsSection categories={skillCategories} />
  <ContactUs contactInfo={contactInfo} />
  <section id="blog" class="py-8 sm:py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <PageHeader
        class="lg:mb-24"
        eyebrow="Blog"
        title="Latest Articles"
        description="Insights on AI development, web technologies, and software engineering."
      />
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {latestPosts.map((post) => <BlogCard {...post} />)}
      </div>
    </div>
  </section>
</Layout>
