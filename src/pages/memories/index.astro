---
import { buttonVariants } from '@/components/ui/button'
import { TypographyH3, TypographyLead } from '@/components/ui/typography'
import { siteConfig } from '@/config/site'
import { NAME } from '@/consts'
import PageHeader from '@/features/common/presentation/page-header.astro'
import MemoryCard from '@/features/memories/presentation/card.astro'
import MemoryModal from '@/features/memories/presentation/modal'
import MainLayout from '@/layouts/main-layout.astro'
import { getMemories } from '@/lib/fetchers'
import { cn } from '@/lib/utils'

const memories = await getMemories()

// Serialize memory data for the React modal component
const memoriesData = memories.map(m => ({
  id: m.id,
  title: m.data.title,
  celebrity_name: m.data.celebrity_name,
  category: m.data.category,
  event_name: m.data.event_name,
  location: m.data.location,
  date: m.data.date.toISOString(),
  year: m.data.year,
  description: m.data.description,
  takeaway_note: m.data.takeaway_note,
  images: m.data.images,
  tags: m.data.tags
}))

const memoriesIndexLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `Memories — ${NAME}`,
  description: `A curated archive of meaningful encounters, celebrity meetings, and professional milestones from ${NAME}'s journey.`,
  url: `${siteConfig.url}/memories`,
  author: {
    '@type': 'Person',
    name: NAME,
    url: siteConfig.url,
    image: `${siteConfig.url}/profile.jpeg`
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${siteConfig.url}/memories`
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: siteConfig.url
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Memories',
        item: `${siteConfig.url}/memories`
      }
    ]
  }
}
---

<MainLayout
  title={`Memories — ${NAME} | Moments & Milestones`}
  description={`A curated archive of meaningful encounters, celebrity meetings, industry events, and professional milestones from ${NAME}'s journey.`}
>
  <section class="py-8 sm:py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {memories.length > 0 ? (
        <>
          <PageHeader
            class="lg:mb-24"
            eyebrow="Memories"
            title="Moments & Milestones"
            description="Meaningful encounters and professional milestones from my journey."
          />

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {memories.map((memory, index) => (
              <MemoryCard key={memory.id} memory={memory} index={index} />
            ))}
          </div>

          <MemoryModal memories={memoriesData} client:load />
        </>
      ) : (
        <div class="py-16 text-center">
          <TypographyH3 className="mb-4 text-2xl tracking-normal">
            No Memories Yet
          </TypographyH3>
          <TypographyLead className="mx-auto mb-8 max-w-md text-lg">
            Exciting moments are being captured. Stay tuned for stories from the journey!
          </TypographyLead>
          <a
            href="/"
            class={cn(buttonVariants({ variant: "outline" }))}
          >
            Back to Home
          </a>
        </div>
      )}
    </div>
  </section>
</MainLayout>

<script type="application/ld+json" set:html={JSON.stringify(memoriesIndexLd)} />
