---
import type { CollectionEntry } from 'astro:content'
import { TypographyH3, TypographyMuted } from '@/components/ui/typography'

type Props = {
  memory: CollectionEntry<'memories'>
  index: number
}

const { memory, index } = Astro.props
const { celebrity_name, category, year, images, event_name } = memory.data
const thumbnail = images[0]

const categoryLabels: Record<string, string> = {
  celebrity: 'Celebrity',
  'tech-leader': 'Tech Leader',
  event: 'Event',
  'office-milestone': 'Milestone',
  community: 'Community'
}
---

<button
  type="button"
  class="group relative overflow-hidden border border-border bg-card text-left shadow-none transition-all duration-300 hover:border-primary hover:shadow-lg cursor-pointer"
  data-memory-index={index}
  aria-label={`View memory: ${celebrity_name}`}
>
  <!-- Image -->
  <div class="relative aspect-square overflow-hidden">
    <img
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      src={thumbnail}
      alt={`Photo with ${celebrity_name}`}
      loading="lazy"
      width="400"
      height="400"
    >

    <!-- Hover overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    />

    <!-- Overlay content on hover -->
    <div
      class="absolute inset-x-0 bottom-0 p-4 translate-y-2 opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100"
    >
      <TypographyMuted className="text-white/80 line-clamp-1">{event_name}</TypographyMuted>
    </div>

    <!-- Year badge -->
    <div
      class="absolute top-3 right-3 rounded-full bg-black/60 px-2.5 py-1 text-xs font-medium text-white backdrop-blur-sm"
    >
      {year}
    </div>
  </div>

  <!-- Card content -->
  <div class="p-4 space-y-2">
    <TypographyH3 className="tracking-normal text-base leading-snug line-clamp-1">{celebrity_name}</TypographyH3>
    <span class="inline-block rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">
      {categoryLabels[category] || category}
    </span>
  </div>
</button>
